{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "Templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": false,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [],
  "file_templates": [
    {
      "regex": "^Job Search/Applications/.*",
      "template": "Templates/Job Application.md"
    },
    {
      "regex": "^Job Search/Recruiters/.*",
      "template": "Templates/Recruiter Contact.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [
    "Templates/Job Application.md",
    "Templates/Recruiter Contact.md"
  ],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": []
}
